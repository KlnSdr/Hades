{
  "dobby": {
    "port": 4077,
    "staticContent": {
      "directory": "static",
      "externalDocRoot": ""
    },
    "session": {
      "store": "hades.session.HadesSessionStore"
    },
    "logLevel": "info"
  },
  "application": {
    "devMode": true,
    "dbHost": "thot-container",
    "psql": {
      "host": "localhost",
      "port": 3306,
      "user": "root",
      "password": "secret",
      "database": "hades"
    }
  },
  "hades": {
    "apidocs": {
      "enabled": true,
      "hideHadesRoutes": false
    },
    "disableWelcomeMessage": true,
    "enableEncryption": false,
    "login": {
      "tokenHeaderName": "Hades-Login-Token",
      "maxAttempts": 5,
      "lockDuration": 300000,
      "redirect": {
        "success": "/",
        "successAdmin": "/hades/"
      }
    },
    "unauthorizedRedirectTarget": "/hades/login",
    "unauthorizedRedirectPaths": [
      "/",
      "/index.html"
    ]
  }
}
